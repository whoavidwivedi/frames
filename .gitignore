.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon
Icon\r\r

# Xcode & DerivedData
build/
DerivedData/
frames.app
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.xcuserdatad/
*.xcuserstate
*.xcbkptlist
*.xccheckout
*.moved-aside
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager & Modular Compilation
.build/
.swiftpm/
Packages/
Package.resolved

# Release Artifacts & Compressed Binaries
dist/
*.dmg
*.zip
*.pkg
*.tar.gz

# Environment Variables & Sensitive Credentials
.env
.env.*
*.p12
*.cer
*.keychain
*.provisionprofile

# Diagnostics & Logs
*.log
crashreporter/
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/
*.profraw
default.profraw

# Agent Tools & Customizations
.agents/
skills-lock.json
